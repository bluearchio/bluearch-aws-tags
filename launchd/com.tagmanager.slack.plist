<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service identification -->
    <key>Label</key>
    <string>com.tagmanager.slack</string>
    
    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tag-manager</string>
        <string>slack</string>
        <string>worker</string>
    </array>
    
    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>AWS_PROFILE</key>
        <string>default</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    
    <!-- Service behavior -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Keep service running -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <!-- Restart throttling -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    
    <!-- Process limits -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
        <key>NumberOfProcesses</key>
        <integer>50</integer>
    </dict>
    
    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/tag-manager-slack.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tag-manager-slack.error.log</string>
    
    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/tmp</string>
    
    <!-- User context -->
    <key>SessionCreate</key>
    <false/>
    
    <!-- Resource usage -->
    <key>ProcessType</key>
    <string>Background</string>
    
    <!-- Exit timeout -->
    <key>ExitTimeOut</key>
    <integer>15</integer>
    
    <!-- Start interval (not used, but can be enabled for periodic execution) -->
    <!-- 
    <key>StartInterval</key>
    <integer>300</integer>
    -->
    
    <!-- Network requirements (ensure network is available) -->
    <key>LaunchOnlyOnce</key>
    <false/>
    
    <!-- Umask for file permissions -->
    <key>Umask</key>
    <integer>22</integer>
    
    <!-- Additional environment setup -->
    <key>EnableGlobbing</key>
    <false/>
    
    <!-- Nice value (process priority) -->
    <key>Nice</key>
    <integer>0</integer>
</dict>
</plist>