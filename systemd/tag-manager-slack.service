[Unit]
Description=AWS Tag Manager Slack Worker
Documentation=https://github.com/bluearch-io/tag-manager-cli
After=network.target network-online.target
Wants=network-online.target
RequiresMountsFor=/tmp

[Service]
Type=simple
User=tag-manager
Group=tag-manager
DynamicUser=yes
StateDirectory=tag-manager
ConfigurationDirectory=tag-manager
LogsDirectory=tag-manager
CacheDirectory=tag-manager

# Environment configuration
Environment="AWS_PROFILE=default"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=512M
TasksMax=50
LimitNOFILE=65536

# Service configuration
ExecStart=/usr/local/bin/tag-manager slack worker
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tag-manager-slack

# Health monitoring
WatchdogSec=60
NotifyAccess=none

[Install]
WantedBy=multi-user.target