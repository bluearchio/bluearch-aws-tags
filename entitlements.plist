<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for PyInstaller binaries to run with hardened runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow dynamic library loading (Python modules) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Disable library validation (Python loads many dynamic libraries) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow JIT compilation (if needed by dependencies) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Network access for AWS API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File system access for SQLite database and cache -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
