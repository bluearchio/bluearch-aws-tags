# AWS Tag Manager CLI - Environment Configuration
# Copy this file to .env and modify the values as needed

# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Database Configuration
DATABASE_URL=postgresql://tag_manager:tag_manager_dev_password@localhost:5432/tag_manager
POSTGRES_DB=tag_manager
POSTGRES_USER=tag_manager
POSTGRES_PASSWORD=tag_manager_dev_password

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application Configuration
TAG_MANAGER_DEBUG=0
TAG_MANAGER_LOG_LEVEL=INFO

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# Automated Tagging Configuration
AUTO_TAGGING_ENABLED=true
AUTO_TAGGING_SCHEDULE_MINUTES=30
AUTO_TAGGING_MAX_RESOURCES_PER_SCAN=1000
AUTO_TAGGING_CLOUDTRAIL_LOOKBACK_HOURS=24

# Rate Limiting
AWS_API_RATE_LIMIT_PER_SECOND=10
CLOUDTRAIL_API_RATE_LIMIT_PER_SECOND=5

# Cache Configuration
CACHE_TTL_RESOURCES=300
CACHE_TTL_CLOUDTRAIL=1800
CACHE_TTL_TAGGING_RULES=3600

# Docker Development Mode
DOCKER_DEV_MODE=false

# Optional: Enable monitoring services (flower for Celery, pgadmin for PostgreSQL, redis-commander for Redis)
# Uncomment the line below to enable monitoring services
# COMPOSE_PROFILES=monitoring,gui

# Optional: Custom ports (uncomment and modify if needed)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# FLOWER_PORT=5555
# PGADMIN_PORT=8080
# REDIS_COMMANDER_PORT=8081

# ===============================================
# Slack Bot Configuration (Optional)
# ===============================================

# Slack App Mode (development or production)
SLACK_APP_MODE=development

# Required Tokens for Development Mode
# Get these from https://api.slack.com/apps/YOUR_APP_ID
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# SLACK_APP_TOKEN=xapp-your-app-token-here
# SLACK_SIGNING_SECRET=your-signing-secret-here

# OAuth Credentials (for Production/Marketplace)
# SLACK_CLIENT_ID=your-client-id-here
# SLACK_CLIENT_SECRET=your-client-secret-here

# Slack OAuth Redirect URI (Static Page)
# Set this to your hosted oauth-redirect.html page
# Examples:
#   GitHub Pages: https://yourusername.github.io/your-repo/oauth-redirect.html
#   Netlify: https://your-app.netlify.app/oauth-redirect.html
#   Vercel: https://your-app.vercel.app/oauth-redirect.html
# SLACK_REDIRECT_URI=https://yourusername.github.io/your-repo/oauth-redirect.html

# Slack Configuration
# SLACK_APPROVAL_CHANNEL=#aws-tag-approvals